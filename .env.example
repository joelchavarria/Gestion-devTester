# Local Supabase values are available after: npm run db:up
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_anon_key
# Optional only for Docker: internal URL used by Next.js server while browsers keep localhost above.
SUPABASE_SERVER_URL=
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

# WhatsApp Cloud API. Keep these server-only and never expose them to the browser.
WHATSAPP_PROVIDER=mock
# Meta Embedded Signup (the business owner completes the official QR/verification in Meta's dialog).
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Private server-only secret from Meta App Dashboard → App settings → Basic.
# Required to exchange the short-lived Embedded Signup code for the tenant token.
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_value
# Used to validate webhook signatures. For one Meta app it is the same value as META_APP_SECRET.
# Numbers and access tokens are never global env vars: Embedded Signup stores one encrypted token per company.
META_WHATSAPP_APP_SECRET=
META_GRAPH_API_VERSION=
# Browser origin allowed in Meta Embedded Signup, e.g. https://delivery.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate once and keep server-only: openssl rand -base64 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Google Maps JavaScript API. Enable Maps JavaScript API and Directions API in Google Cloud.
NEXT_PUBLIC_MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_google_maps_browser_key
